        <!-- 注 1 -->
        <mxCell id="note1_title" value="rb_uart — 字节环形缓冲" style="text;fontSize=12;fontStyle=1;fontColor=#1565C0;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="130" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note1_body" value="解耦「串口速率 ≠ 解析速率」&#xa;字节级搬运，不关心帧边界&#xa;留空位法满/空判定（size ≥ 2）" style="text;fontSize=11;fontColor=#555555;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="460" height="55" as="geometry" />
        </mxCell>

        <!-- 注 2 -->
        <mxCell id="note2_title" value="rb_json — JSON 行环形缓冲" style="text;fontSize=12;fontStyle=1;fontColor=#1565C0;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="215" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note2_body" value="解耦「解析速率 ≠ 网络速率」&#xa;上传线程按 \n 切行，提供消息边界" style="text;fontSize=11;fontColor=#555555;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="650" y="235" width="460" height="40" as="geometry" />
        </mxCell>

        <!-- 注 3 -->
        <mxCell id="note3_title" value="两条 rb 共同的并发机制" style="text;fontSize=12;fontStyle=1;fontColor=#1565C0;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="285" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note3_body" value="写满阻塞 / 读空阻塞（条件变量 + mutex）&#xa;stop → 双 broadcast 唤醒所有等待线程&#xa;while 防虚假唤醒（不是 if）&#xa;排空语义：abort &amp;&amp; is_empty 才退出" style="text;fontSize=11;fontColor=#555555;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="650" y="305" width="460" height="70" as="geometry" />
        </mxCell>

        <!-- 底部图例 -->
        <mxCell id="legend" value="图例　　蓝色 = 外部 I/O　　绿色 = pthread 线程　　蓝线 = 内存缓冲　　红线 = TCP" style="text;fontSize=11;fontColor=#888888;align=center;" vertex="1" parent="1">
